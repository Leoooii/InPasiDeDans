rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@gmail.com';
    }

    // ===== Conținut public al site-ului =====
    // Citire publică (afișat pe site oricui), scriere permisivă
    // (fiindcă API routes accesează aceste colecții fără auth — vezi nota la final).

    match /tarife/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /evenimente/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /excursii/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /petreceri/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /instructori/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Grupe: orarul public al cursurilor (titlu, instructor, locuri) — date
    // nesensibile, citire publică. Pagina /program face un list query nefiltrat
    // pe toată colecția (vezi components/program-dinamic.tsx); o regulă care
    // depinde de resource.data.publica ar respinge acel query cu „Missing or
    // insufficient permissions". Scriere permisivă pentru API routes.
    match /grupe/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ===== Evidență cursanți (admin + portalul instructorilor) =====
    // Scrierile vin din browser, cu utilizatorul autentificat (lib/evidenta/repo.ts).
    // Instructorii au un document în `conturiInstructori/{uid}` cu `activ` și `grupe`
    // (id-uri din colecția `grupe`); lucrează doar cu grupele lor.

    function contInstructor() {
      return get(/databases/$(database)/documents/conturiInstructori/$(request.auth.uid)).data;
    }

    function isInstructor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conturiInstructori/$(request.auth.uid))
        && contInstructor().activ == true;
    }

    function isStaff() {
      return isAdmin() || isInstructor();
    }

    function predaGrupa(grupaId) {
      return isInstructor() && grupaId in contInstructor().grupe;
    }

    function doarCampurile(campuri) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campuri);
    }

    match /cursanti/{docId} {
      allow read: if isStaff();
      allow create: if isAdmin()
                    || (isInstructor()
                        && request.resource.data.grupe.size() > 0
                        && request.resource.data.grupe.hasOnly(contInstructor().grupe));
      // Instructorul: date de contact + grupele LUI (adaugă/scoate doar din ale lui),
      // pentru cursanții care sunt sau ajung într-una din grupele lui.
      allow update: if isAdmin()
                    || (isInstructor()
                        && doarCampurile(['grupe', 'nume', 'telefon', 'email', 'observatii', 'avatar'])
                        && (resource.data.grupe.hasAny(contInstructor().grupe)
                            || request.resource.data.grupe.hasAny(contInstructor().grupe))
                        && request.resource.data.grupe.toSet().difference(resource.data.grupe.toSet()).hasOnly(contInstructor().grupe)
                        && resource.data.grupe.toSet().difference(request.resource.data.grupe.toSet()).hasOnly(contInstructor().grupe));
      allow delete: if isAdmin();
    }

    match /abonamente/{docId} {
      allow read: if isStaff();
      allow create: if isAdmin()
                    || (isInstructor()
                        && request.resource.data.createdBy.uid == request.auth.uid
                        && request.resource.data.anulat == false);
      // Instructorul modifică doar contorul și perioada (prima ședință a unui Full Pass).
      allow update: if isAdmin()
                    || (isInstructor() && doarCampurile(['sedinteFolosite', 'dataStart', 'dataExpirare']));
      allow delete: if isAdmin();
    }

    match /prezente/{docId} {
      // `userId`: compatibilitate cu pagina veche /cont (nu mai scrie nimeni astfel de documente)
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
                    || (predaGrupa(request.resource.data.grupaId)
                        && request.resource.data.createdBy.uid == request.auth.uid);
      // legarea unei ședințe de un abonament vândut ulterior
      allow update: if isAdmin() || (isInstructor() && doarCampurile(['abonamentId']));
      allow delete: if isAdmin() || predaGrupa(resource.data.grupaId);
    }

    // Istoricul acțiunilor: doar se adaugă, fiecare cu autorul real.
    match /jurnal/{docId} {
      allow create: if isStaff() && request.resource.data.actor.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Avatarul poate fi o poză decupată (data URL, ~30 KB); limită de siguranță.
    function avatarMic() {
      return !('avatar' in request.resource.data) || request.resource.data.avatar.size() < 200000;
    }

    match /conturiInstructori/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() && avatarMic();
      allow delete: if isAdmin();
      // instructorul activ își schimbă singur numele și avatarul („Contul meu")
      allow update: if isSignedIn() && request.auth.uid == uid
                    && resource.data.activ == true
                    && doarCampurile(['nume', 'avatar'])
                    && avatarMic();
    }

    // Profilurile de pe pagina de intrare (/panou): nume, avatar, email, rol.
    // Citire publică (cine intră își alege profilul înainte să fie logat).
    match /conturiPublice/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && avatarMic();
      allow delete: if isAdmin();
      // proprietarul își actualizează numele și avatarul din „Contul meu"
      allow update: if isSignedIn() && request.auth.uid == uid
                    && doarCampurile(['nume', 'avatar'])
                    && avatarMic();
    }

    // Setări comune ale evidenței (ex. textele mesajelor de WhatsApp)
    match /setari/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Profilul adminului (nume afișat, avatar)
    match /profiluri/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow create, update: if isAdmin() && request.auth.uid == uid && avatarMic();
    }

    // ===== Înscrieri din formularele site-ului =====
    // /api/send doar CREEAZĂ documente (client SDK fără auth); citirea,
    // schimbarea statusului și ștergerea se fac din /admin/inscrieri,
    // cu adminul autentificat în browser.
    match /inscrieri/{docId} {
      allow create: if request.resource.data.status == 'nou'
                    && request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'message', 'danceclass', 'instructor',
                         'sursa', 'tip', 'grupaId', 'status', 'consent', 'createdAt'
                       ]);
      allow read, update, delete: if isAdmin();
    }

    // ===== Galeria de imagini admin =====
    // Nu e accesată prin API routes — pot fi admin-only safe.
    match /imagini/{docId} {
      allow read: if true; // imaginile sunt afișate public pe site
      allow write: if isAdmin();
    }

    // ===== Conturi utilizatori =====
    // Fiecare user își poate citi/modifica propriul document.
    // Adminul are acces complet. Crearea e permisă la înregistrare
    // (utilizatorul tocmai s-a autentificat și creează doc-ul cu UID-ul propriu).
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.aprobat == false
                    && request.resource.data.role == 'cursant';
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.aprobat == resource.data.aprobat
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ===== Default deny =====
    // Orice colecție nedeclarată explicit e blocată.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
